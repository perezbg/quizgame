roundStartTime = millis();
}

bool buttonPressed(uint8_t index) {
bool reading = digitalRead(BUTTON_PINS[index]);

if (reading != buttonLastReading[index]) {
buttonLastChange[index] = millis();
buttonLastReading[index] = reading;
}

if (millis() - buttonLastChange[index] > 25 &&
reading != buttonStable[index]) {
buttonStable[index] = reading;
if (buttonStable[index] == LOW) {
wakeScreensaver();
return true;
}
return false;
}

return false;
}

void buzzerBegin() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
ledcAttach(BUZZER_PIN, 2000, 10);
#else
ledcSetup(BUZZER_CHANNEL, 2000, 10);
ledcAttachPin(BUZZER_PIN, BUZZER_CHANNEL);
#endif
ledcWriteTone(
#if ESP_ARDUINO_VERSION_MAJOR >= 3
BUZZER_PIN,
#else
BUZZER_CHANNEL,
#endif
0
);
}

void buzzerSetTone(uint16_t frequency) {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
ledcWriteTone(BUZZER_PIN, frequency);
#else
ledcWriteTone(BUZZER_CHANNEL, frequency);
#endif
}

void buzzerStop() {
buzzerSetTone(0);
}

void restartProgram() {
shortBeepActive = false;
buzzerStop();

if (displayAvailable[0]) {
drawMessage(display1, font1, "", "Рестартирам се", "", "");
}
if (displayAvailable[1]) {
drawMessage(display2, font2, "", "Рестартирам се", "", "");
}

delay(700);
esp_restart();
}

// A + Б held together by either player restarts the ESP32 after 3 seconds.
// Returns true while any restart chord is held, suppressing answer registration.
bool checkRestartGesture() {
bool anyChordHeld = false;
unsigned long now = millis();

for (uint8_t player = 0; player < 2; player++) {
uint8_t firstButton = player * 2;
bool bothHeld = digitalRead(BUTTON_PINS[firstButton]) == LOW &&
digitalRead(BUTTON_PINS[firstButton + 1]) == LOW;

if (bothHeld) {
anyChordHeld = true;
if (!restartChordTiming[player]) {
restartChordTiming[player] = true;
restartChordStartedAt[player] = now;
wakeScreensaver();
} else if (now - restartChordStartedAt[player] >= RESTART_HOLD_MS) {
restartProgram();
return true;
}
} else {
restartChordTiming[player] = false;
}

}

return anyChordHeld;
}

void startShortBeep(uint8_t player) {
buzzerSetTone(player == 0 ? PLAYER1_BEEP_HZ : PLAYER2_BEEP_HZ);
shortBeepActive = true;
shortBeepOffAt = millis() + SHORT_BEEP_MS;
}

void updateBuzzer() {
if (shortBeepActive && (long)(millis() - shortBeepOffAt) >= 0) {
buzzerStop();
shortBeepActive = false;
}
}

void delayWhileUpdatingBuzzer(unsigned long durationMs) {
unsigned long startedAt = millis();
while (millis() - startedAt < durationMs) {
webServer.handleClient();
updateBuzzer();
checkRestartGesture();
delay(1);
}
}

void recordAnswer(uint8_t player, uint8_t choice) {
if (answered[player]) return;

answered[player] = true;
answerTime[player] = millis();
answerWasCorrect[player] = (choice == correctButton);
startShortBeep(player);

if (tournamentActive && activeStudent[player] >= 0) {
uint8_t student = (uint8_t)activeStudent[player];
uint32_t responseMs = answerTime[player] - roundStartTime;
recordStudentAnswer(student, answerWasCorrect[player], responseMs);
if (answerWasCorrect[player]) {
sessionCorrectAnswers[student]++;
sessionCorrectMs[student] += responseMs;
}
}

if (soloMode) return;

if (player == 0 && displayAvailable[0]) {
drawMessage(display1, font1, "", "Отговорът е приет", "Изчакай съученика", "");
} else if (player == 1 && displayAvailable[1]) {
drawMessage(display2, font2, "", "Отговорът е", "Изчакай съученика", "");
}
}

