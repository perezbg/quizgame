void celebrateAndRestart() {
shortBeepActive = false;
buzzerStop();

unsigned long startedAt = millis();
unsigned long nextBlinkAt = startedAt;
unsigned long nextNoteAt = startedAt;
unsigned long noteEndsAt = startedAt;
uint8_t noteIndex = 0;
uint8_t victoryPlayCount = 0;
bool notePlaying = false;
bool visible = true;

// Blink the victory message for 15 seconds and play exactly five full fanfares.
while (millis() - startedAt < VICTORY_DURATION_MS) {
unsigned long now = millis();
checkRestartGesture();

if ((long)(now - nextBlinkAt) >= 0) {
showVictoryFrame(visible);
visible = !visible;
nextBlinkAt = now + 500;
}

if (notePlaying && (long)(now - noteEndsAt) >= 0) {
buzzerStop();
notePlaying = false;
nextNoteAt = now + VICTORY_GAP_MS;
}

if (!notePlaying && victoryPlayCount < VICTORY_REPEAT_COUNT &&
(long)(now - nextNoteAt) >= 0) {
buzzerSetTone(VICTORY_NOTES[noteIndex]);
noteEndsAt = now + VICTORY_NOTE_MS[noteIndex];
noteIndex++;
if (noteIndex >= VICTORY_NOTE_COUNT) {
noteIndex = 0;
victoryPlayCount++;
}
notePlaying = true;
}

delay(5);

}

buzzerStop();
scores[0] = 0;
scores[1] = 0;
startNewRound();
}

void finishSoloRound() {
uint8_t player = soloPlayer;
Adafruit_SH1106G& display = player == 0 ? display1 : display2;
U8G2_FOR_ADAFRUIT_GFX& font = player == 0 ? font1 : font2;

if (answerWasCorrect[player]) {
scores[player]++;
char scoreLine[24];
snprintf(scoreLine, sizeof(scoreLine), "%u / %u точки", (unsigned)scores[player], (unsigned)TOTAL_POINTS_TO_WIN);
drawMessage(display, font, "Ти спечели", "точка!", "Резултат:", scoreLine);
} else {
char scoreLine[24];
snprintf(scoreLine, sizeof(scoreLine), "%u / %u точки", (unsigned)scores[player], (unsigned)TOTAL_POINTS_TO_WIN);
drawMessage(display, font, "Грешен отговор", "Няма точка", "Резултат:", scoreLine);
}

delayWhileUpdatingBuzzer(1800);

if (scores[player] >= TOTAL_POINTS_TO_WIN) {
celebrateAndRestart();
} else {
startNewRound();
}
}

void finishRound() {
flushStudentStats();
bool tournamentRound = tournamentActive;
int winner = -1;
bool tiedCorrectAnswers = false;

if (answerWasCorrect[0] && answerWasCorrect[1]) {
if (answerTime[0] < answerTime[1]) winner = 0;
else if (answerTime[1] < answerTime[0]) winner = 1;
else tiedCorrectAnswers = true;
} else if (answerWasCorrect[0]) {
winner = 0;
} else if (answerWasCorrect[1]) {
winner = 1;
}

if (winner >= 0) {
scores[winner]++;

if (winner == 0) {
drawMessage(display1, font1, "Ти спечели", "точка!", "", "");
drawMessage(display2, font2, "Твоят съученик", "спечели точка!", "", "");
} else {
drawMessage(display2, font2, "Ти спечели", "точка!", "", "");
drawMessage(display1, font1, "Твоят съученик", "спечели точка!", "", "");
}

} else if (tiedCorrectAnswers) {
drawMessage(display1, font1, "", "Равенство", "Няма точка", "");
drawMessage(display2, font2, "", "Равенство", "Няма точка", "");
} else {
drawMessage(display1, font1, "", "Двата отговора", "са грешни", "");
drawMessage(display2, font2, "", "Двата отговора", "са грешни", "");
}

delayWhileUpdatingBuzzer(1800);

if (tournamentRound) {
if (!tournamentActive) return; // The teacher may end the tournament from the web page during the message.
if (scores[0] >= tournamentPointsToWin || scores[1] >= tournamentPointsToWin) {
uint8_t winnerPlayer = scores[0] > scores[1] ? 0 : 1;
uint8_t winningStudent = (uint8_t)activeStudent[winnerPlayer];
sessionMatchWins[winningStudent]++;
recordStudentMatchWon(winningStudent);
saveOneStudentStats(winningStudent);
char scoreLine[24];
snprintf(scoreLine, sizeof(scoreLine), "%u - %u точки", (unsigned)scores[0], (unsigned)scores[1]);
if (displayAvailable[0]) drawMessage(display1, font1, "Мачът спечели:", studentNames[winningStudent], "Резултат:", scoreLine);
if (displayAvailable[1]) drawMessage(display2, font2, "Мачът спечели:", studentNames[winningStudent], "Резултат:", scoreLine);
delayWhileUpdatingBuzzer(1800);
if (tournamentActive) startNextTournamentMatch();
} else {
startNewRound();
}
return;
}

if (scores[0] + scores[1] >= TOTAL_POINTS_TO_WIN) {
celebrateAndRestart();
} else {
startNewRound();
}
}

void setup() {
Serial.begin(115200);
randomSeed(esp_random());
pinMode(BUZZER_PIN, OUTPUT);
buzzerBegin();

for (uint8_t i = 0; i < 4; i++) {
pinMode(BUTTON_PINS[i], INPUT_PULLUP);
}

loadQuestionsFromStorage();
loadClassSettings();
previewFont.begin(previewCanvas);

Wire.begin(21, 22);
I2C_2.begin(25, 26);

displayAvailable[0] = display1.begin(0x3C, true);
if (displayAvailable[0]) {
font1.begin(display1);
} else {
Serial.println("Display 1 не е открит; ще се използва Display 2, ако е наличен.");
}

displayAvailable[1] = display2.begin(0x3C, true);
if (displayAvailable[1]) {
font2.begin(display2);
} else {
Serial.println("Display 2 не е открит; ще се използва Display 1, ако е наличен.");
}

if (!displayAvailable[0] && !displayAvailable[1]) {
Serial.println("Не е открит дисплей. Играта няма визуален изход.");
}

soloMode = displayAvailable[0] != displayAvailable[1];
if (soloMode) {
soloPlayer = displayAvailable[0] ? 0 : 1;
Serial.println("Самостоятелен режим: използват се бутоните на играча с работещия дисплей.");
}

startWebInterface();
lastButtonActivityAt = millis();
if (gameMode == GAME_MODE_TOURNAMENT) {
if (!soloMode && startTournament()) return;
showTournamentIdle();
} else {
startNewRound();
}
}

void loop() {
webServer.handleClient();
updateBuzzer();
updateScreensaver();

if (checkRestartGesture()) return;
if ((!displayAvailable[0] && !displayAvailable[1]) || QUESTION_COUNT == 0) return;
if (gameMode == GAME_MODE_TOURNAMENT && !tournamentActive) return;
if (tournamentReadyPhase) {
for (uint8_t player = 0; player < 2; player++) {
uint8_t buttonA = player * 2;
uint8_t buttonB = buttonA + 1;
if (choosingOtherPlayer[player]) {
if (buttonPressed(buttonA)) {
selectReplacementPlayer(player);
} else if (buttonPressed(buttonB)) {
if (otherPlayerCandidateCount[player] > 0) {
otherPlayerSelection[player]++;
if (otherPlayerSelection[player] >= otherPlayerCandidateCount[player]) otherPlayerSelection[player] = 0;
showPlayerSelectionMenu(player);
} else {
choosingOtherPlayer[player] = false;
showReadyPrompt(player);
}
}
} else if (!readyForMatch[player]) {
if (buttonPressed(buttonA)) {
readyForMatch[player] = true;
showReadyWaiting(player);
} else if (buttonPressed(buttonB)) {
openOtherPlayerMenu(player);
}
}
}
if (readyForMatch[0] && readyForMatch[1] && !choosingOtherPlayer[0] && !choosingOtherPlayer[1]) beginTournamentMatch();
return;
}

if (soloMode) {
uint8_t firstButton = soloPlayer * 2;
if (!answered[soloPlayer]) {
if (buttonPressed(firstButton)) recordAnswer(soloPlayer, 0);
if (!answered[soloPlayer] && buttonPressed(firstButton + 1)) {
recordAnswer(soloPlayer, 1);
}
}
if (answered[soloPlayer]) finishSoloRound();
return;
}

if (!answered[0]) {
if (buttonPressed(0)) recordAnswer(0, 0); // Играч 1, A
if (!answered[0] && buttonPressed(1)) recordAnswer(0, 1); // Играч 1, B
}

if (!answered[1]) {
if (buttonPressed(2)) recordAnswer(1, 0); // Играч 2, A
if (!answered[1] && buttonPressed(3)) recordAnswer(1, 1); // Играч 2, B
}

flushStudentStats();
if (answered[0] && answered[1]) {
finishRound();
}
}
