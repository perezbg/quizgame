void updateScreensaver() {
unsigned long now = millis();
if (!screensaverActive && now - lastButtonActivityAt >= SCREENSAVER_IDLE_MS) {
screensaverActive = true;
showScreensaver();
lastClockFrameAt = now;
} else if (screensaverActive && now - lastClockFrameAt >= 1000UL) {
showScreensaver();
lastClockFrameAt = now;
}
}

void wakeScreensaver() {
lastButtonActivityAt = millis();
if (screensaverActive) {
screensaverActive = false;
if (gameMode == GAME_MODE_TOURNAMENT && !tournamentActive) showTournamentIdle();
else if (tournamentReadyPhase) {
for (uint8_t p = 0; p < 2; p++) {
if (choosingOtherPlayer[p]) showPlayerSelectionMenu(p);
else if (readyForMatch[p]) showReadyWaiting(p);
else showReadyPrompt(p);
}
} else if (QUESTION_COUNT > 0 && currentQuestion >= 0) showCurrentQuestion();
}
}

