void openOtherPlayerMenu(uint8_t player) {
if (player > 1) return;
otherPlayerCandidateCount[player] = 0;
otherPlayerSelection[player] = 0;
uint8_t present[MAX_STUDENTS];
uint8_t count = getPresentStudents(present);
for (uint8_t i = 0; i < count; i++) {
uint8_t candidate = present[i];
uint8_t position = otherPlayerCandidateCount[player];
while (position > 0 && compareBulgarianNames(studentNames[candidate],
studentNames[otherPlayerCandidates[player][position - 1]]) < 0) {
otherPlayerCandidates[player][position] = otherPlayerCandidates[player][position - 1];
position--;
}
otherPlayerCandidates[player][position] = candidate;
otherPlayerCandidateCount[player]++;
}
choosingOtherPlayer[player] = true;
showPlayerSelectionMenu(player);
}

void selectReplacementPlayer(uint8_t player) {
if (otherPlayerCandidateCount[player] == 0) {
choosingOtherPlayer[player] = false;
showReadyPrompt(player);
return;
}
uint8_t replacement = otherPlayerCandidates[player][otherPlayerSelection[player]];
choosingOtherPlayer[player] = false;

if (replacement == activeStudent[player]) {
showReadyPrompt(player);
return;
}

if (replacement == activeStudent[1 - player]) {
int8_t previousPlayer = activeStudent[player];
activeStudent[player] = activeStudent[1 - player];
activeStudent[1 - player] = previousPlayer;
readyForMatch[0] = readyForMatch[1] = false;
choosingOtherPlayer[0] = choosingOtherPlayer[1] = false;
showReadyPrompt(0);
showReadyPrompt(1);
return;
}

for (uint8_t i = tournamentOrderPosition; i < tournamentOrderCount; i++) {
if (tournamentOrder[i] == replacement) {
for (uint8_t j = i; j + 1 < tournamentOrderCount; j++) tournamentOrder[j] = tournamentOrder[j + 1];
tournamentOrderCount--;
break;
}
}
activeStudent[player] = replacement;
readyForMatch[player] = false;
showReadyPrompt(player);
if (readyForMatch[1 - player]) showReadyWaiting(1 - player);
}

void showReadyWaiting(uint8_t player) {
if (player > 1 || activeStudent[player] < 0) return;
Adafruit_SH1106G& display = player == 0 ? display1 : display2;
U8G2_FOR_ADAFRUIT_GFX& font = player == 0 ? font1 : font2;
uint8_t other = 1 - player;
const char* otherName = studentNames[(uint8_t)activeStudent[other]];
drawMessage(display, font, "", "Изчакваме", otherName, "");
}

void startNextTournamentMatch() {
if (!tournamentActive) return;
if (tournamentOrderPosition + 1 >= tournamentOrderCount) {
int8_t carryStudent = -1;
if (tournamentOrderPosition < tournamentOrderCount) carryStudent = (int8_t)tournamentOrder[tournamentOrderPosition];
shuffleTournamentOrder();
if (carryStudent >= 0 && tournamentOrderCount > 1) {
for (uint8_t i = 0; i < tournamentOrderCount; i++) {
if (tournamentOrder[i] == (uint8_t)carryStudent) {
uint8_t first = tournamentOrder[0];
tournamentOrder[0] = tournamentOrder[i];
tournamentOrder[i] = first;
break;
}
}
}
}
if (tournamentOrderCount < 2) {
tournamentActive = false;
tournamentReadyPhase = false;
activeStudent[0] = activeStudent[1] = -1;
showTournamentIdle();
return;
}

activeStudent[0] = tournamentOrder[tournamentOrderPosition++];
activeStudent[1] = tournamentOrder[tournamentOrderPosition++];
screensaverActive = false;
lastButtonActivityAt = millis();
scores[0] = scores[1] = 0;
readyForMatch[0] = readyForMatch[1] = false;
choosingOtherPlayer[0] = choosingOtherPlayer[1] = false;
tournamentReadyPhase = true;
synchronizeButtonStates();
showReadyPrompt(0);
showReadyPrompt(1);
}

void beginTournamentMatch() {
if (!tournamentActive || !readyForMatch[0] || !readyForMatch[1]) return;
tournamentReadyPhase = false;
uint8_t student0 = (uint8_t)activeStudent[0];
uint8_t student1 = (uint8_t)activeStudent[1];
sessionMatchesPlayed[student0]++;
sessionMatchesPlayed[student1]++;
recordStudentMatchPlayed(student0);
recordStudentMatchPlayed(student1);
sessionMatchCount++;
saveStudentStats();
synchronizeButtonStates();
startNewRound();
}

int compareSessionPlayers(uint8_t a, uint8_t b) {
if (sessionMatchWins[a] != sessionMatchWins[b]) return sessionMatchWins[a] > sessionMatchWins[b] ? 1 : -1;
if (sessionCorrectAnswers[a] != sessionCorrectAnswers[b]) return sessionCorrectAnswers[a] > sessionCorrectAnswers[b] ? 1 : -1;
uint64_t avgA = sessionCorrectAnswers[a] ? sessionCorrectMs[a] / sessionCorrectAnswers[a] : 0;
uint64_t avgB = sessionCorrectAnswers[b] ? sessionCorrectMs[b] / sessionCorrectAnswers[b] : 0;
if (avgA != avgB) return avgA < avgB ? 1 : -1;
return 0;
}

int findTournamentWinner() {
int best = -1;
bool tied = false;
for (uint8_t i = 0; i < studentCount; i++) {
if (!sessionMatchesPlayed[i]) continue;
if (best < 0) { best = i; tied = false; continue; }
int comparison = compareSessionPlayers(i, best);
if (comparison > 0) { best = i; tied = false; }
else if (comparison == 0) tied = true;
}
if (tied) return -2;
return best;
}

void finishTournament() {
tournamentActive = false;
tournamentReadyPhase = false;
readyForMatch[0] = readyForMatch[1] = false;
choosingOtherPlayer[0] = choosingOtherPlayer[1] = false;
activeStudent[0] = activeStudent[1] = -1;
screensaverActive = false;
lastButtonActivityAt = millis();
int winner = findTournamentWinner();
if (winner == -2) {
if (displayAvailable[0]) drawMessage(display1, font1, "НАДПРЕВАРАТА", "приключи", "Равенство", "Браво на всички!");
if (displayAvailable[1]) drawMessage(display2, font2, "НАДПРЕВАРАТА", "приключи", "Равенство", "Браво на всички!");
} else if (winner < 0) {
if (displayAvailable[0]) drawMessage(display1, font1, "НАДПРЕВАРАТА", "приключи", "Няма изигран мач", "Опитай отново");
if (displayAvailable[1]) drawMessage(display2, font2, "НАДПРЕВАРАТА", "приключи", "Няма изигран мач", "Опитай отново");
} else {
char wins[32], correct[32];
snprintf(wins, sizeof(wins), "Победи: %lu", (unsigned long)sessionMatchWins[winner]);
snprintf(correct, sizeof(correct), "Верни: %lu", (unsigned long)sessionCorrectAnswers[winner]);
if (displayAvailable[0]) drawMessage(display1, font1, "ПОБЕДИТЕЛ:", studentNames[winner], wins, correct);
if (displayAvailable[1]) drawMessage(display2, font2, "ПОБЕДИТЕЛ:", studentNames[winner], wins, correct);
}
}

void synchronizeButtonStates() {
unsigned long now = millis();
for (uint8_t i = 0; i < 4; i++) {
bool reading = digitalRead(BUTTON_PINS[i]);
buttonStable[i] = reading;
buttonLastReading[i] = reading;
buttonLastChange[i] = now;
}
}

