showTournamentIdle();
return;
}
if (QUESTION_COUNT == 0) {
if (displayAvailable[0]) drawMessage(display1, font1, "", "Няма въпроси", "Отвори уеб", "интерфейса");
if (displayAvailable[1]) drawMessage(display2, font2, "", "Няма въпроси", "Отвори уеб", "интерфейса");
