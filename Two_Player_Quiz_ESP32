return u8g2_font_9x15_t_cyrillic;
}

const uint8_t* answerFontForSize(int size) {
if (size <= 1) return u8g2_font_5x8_t_cyrillic;
if (size == 2) return u8g2_font_6x12_t_cyrillic;
return u8g2_font_9x15_t_cyrillic;
