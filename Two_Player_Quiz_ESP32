void drawCenteredQuestionLine(U8G2_FOR_ADAFRUIT_GFX& font,
const char* text, int16_t baseline) {
int16_t width = font.getUTF8Width(text);
int16_t x = (128 - width) / 2;
if (x < 0) x = 0;

// Draw once for a clean, readable character shape.
font.drawUTF8(x, baseline, text);
}

void drawAnswerOptions(U8G2_FOR_ADAFRUIT_GFX& font,
const char* answerA, const char* answerB,
int16_t offsetY) {
char textA[128];
char textB[128];
bool hasAnswerB = answerB && answerB[0] != '\0';
snprintf(textA, sizeof(textA), "A: %s", answerA);
if (hasAnswerB) snprintf(textB, sizeof(textB), "Б: %s", answerB);
else textB[0] = '\0';

int size = ANSWER_FONT_SIZE;
font.setFont(answerFontForSize(size));

int16_t widthA = font.getUTF8Width(textA);
int16_t widthB = hasAnswerB ? font.getUTF8Width(textB) : 0;

// Keep the requested size unless both choices would overlap.
while (hasAnswerB && size > 1 && widthA + widthB + 6 > 128) {
size--;
font.setFont(answerFontForSize(size));
widthA = font.getUTF8Width(textA);
widthB = font.getUTF8Width(textB);
}

font.drawUTF8(0, displayTextY(61, offsetY), textA); // A is flush left
if (hasAnswerB) font.drawUTF8(128 - widthB, displayTextY(61, offsetY), textB); // B is flush right
}

void drawQuestionCore(Adafruit_GFX& canvas,
U8G2_FOR_ADAFRUIT_GFX& font,
const char* line1, const char* line2,
const char* answerA, const char* answerB,
int16_t offsetY) {
canvas.fillScreen(0);

int size = QUESTION_FONT_SIZE;
font.setFont(questionFontForSize(size));
int16_t width1 = font.getUTF8Width(line1);
int16_t width2 = font.getUTF8Width(line2);

while (size > 1 && (width1 > 126 || width2 > 126)) {
size--;
font.setFont(questionFontForSize(size));
width1 = font.getUTF8Width(line1);
width2 = font.getUTF8Width(line2);
}

font.setFontMode(1);
font.setForegroundColor(1);

int16_t ascent = font.getFontAscent();
int16_t height = ascent - font.getFontDescent();
int16_t lineCount = (line2[0] == '\0') ? 1 : 2;
int16_t totalHeight = lineCount * height + (lineCount - 1) * 2;
int16_t top = (40 - totalHeight) / 2;
if (top < 0) top = 0;

drawCenteredQuestionLine(font, line1,
displayTextY(top + ascent, offsetY));
if (lineCount == 2) {
drawCenteredQuestionLine(font, line2,
displayTextY(top + ascent + height + 2, offsetY));
}

if (SHOW_SEPARATOR_LINE) {
for (uint8_t i = 0; i < SEPARATOR_LINE_THICKNESS; i++) {
canvas.drawFastHLine(0, displayTextY(43 + i, offsetY), 128, 1);
}
}

drawAnswerOptions(font, answerA, answerB, offsetY);
}

