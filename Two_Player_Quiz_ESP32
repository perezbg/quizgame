memcpy(oldStats, studentStats, sizeof(oldStats));
uint8_t oldCount = studentCount;
memset(studentStats, 0, sizeof(studentStats));
memset(studentStatsDirty, 0, sizeof(studentStatsDirty));
memcpy(studentNames, newStudents, sizeof(studentNames));
memcpy(absentNames, newAbsents, sizeof(absentNames));
studentCount = newStudentCount;
absentCount = newAbsentCount;
studentsCsv = "";
for (uint8_t i = 0; i < studentCount; i++) {
if (i) studentsCsv += ", ";
studentsCsv += studentNames[i];
