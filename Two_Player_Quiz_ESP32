}
preferences.putUChar("gameMode", gameMode);
preferences.putUChar("targetPts", tournamentPointsToWin);
tournamentActive = false;
tournamentReadyPhase = false;
readyForMatch[0] = readyForMatch[1] = false;
choosingOtherPlayer[0] = choosingOtherPlayer[1] = false;
activeStudent[0] = activeStudent[1] = -1;
screensaverActive = false;
lastButtonActivityAt = millis();
