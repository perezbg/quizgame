bool getLocalDateTime(struct tm& timeInfo) {
time_t now = time(nullptr);
if (now < 1700000000) return false; // NTP has not set the clock yet.
return localtime_r(&now, &timeInfo) != nullptr;
}

String expandTemplate(const String& source) {
struct tm t;
String result = source;
if (!getLocalDateTime(t)) {
result.replace("{ДЕН_ОТ_СЕДМИЦАТА}", "няма час");
result.replace("{СЛЕДВАЩ_ДЕН}", "няма час");
result.replace("{ДАТА}", "--");
result.replace("{МЕСЕЦ}", "няма час");
result.replace("{ГОДИНА}", "----");
return result;
}
result.replace("{ДЕН_ОТ_СЕДМИЦАТА}", WEEKDAYS_BG[t.tm_wday]);
result.replace("{СЛЕДВАЩ_ДЕН}", WEEKDAYS_BG[(t.tm_wday + 1) % 7]);
result.replace("{ДАТА}", String(t.tm_mday));
result.replace("{МЕСЕЦ}", MONTHS_BG[t.tm_mon]);
result.replace("{ГОДИНА}", String(t.tm_year + 1900));
return result;
}

