bool namesEqual(const char* a, const char* b) {
return String(a).equalsIgnoreCase(String(b));
}

bool parseNameCsv(const String& csv, char output[MAX_STUDENTS][32], uint8_t& count) {
count = 0;
int start = 0;
for (int position = 0; position <= (int)csv.length(); position++) {
bool separator = position == (int)csv.length();
if (!separator) {
char c = csv[position];
separator = c == ',' || c == ';' || c == '\n' || c == '\r';
}
if (!separator) continue;
String name = csv.substring(start, position);
name.trim();
if (name.length()) {
if (name.length() > 31) return false;
bool duplicate = false;
for (uint8_t i = 0; i < count; i++) {
if (namesEqual(output[i], name.c_str())) duplicate = true;
}
if (!duplicate) {
if (count >= MAX_STUDENTS) return false;
strlcpy(output[count], name.c_str(), sizeof(output[count]));
count++;
}
}
start = position + 1;
}
return true;
}

int findStatByName(const StudentStats* records, uint8_t count, const char* name) {
for (uint8_t i = 0; i < count; i++) {
if (namesEqual(records[i].name, name)) return i;
}
return -1;
}

