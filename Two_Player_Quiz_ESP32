if (isNew && QUESTION_COUNT >= MAX_QUESTIONS) { webServer.send(400, "text/plain; charset=utf-8", "Достигнат е лимитът от 24 въпроса."); return; }
if (isNew) index = QUESTION_COUNT++;
strlcpy(questions[index].line1, line1.c_str(), sizeof(questions[index].line1));
strlcpy(questions[index].line2, line2.c_str(), sizeof(questions[index].line2));
