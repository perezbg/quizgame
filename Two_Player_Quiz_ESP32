uint32_t nextUtf8Codepoint(const char*& text) {
unsigned char first = (unsigned char)*text++;
if (first < 0x80) return first;
if ((first & 0xE0) == 0xC0) {
uint32_t value = (uint32_t)(first & 0x1F) << 6;
value |= (unsigned char)*text++ & 0x3F;
return value;
}
if ((first & 0xF0) == 0xE0) {
uint32_t value = (uint32_t)(first & 0x0F) << 12;
value |= ((unsigned char)*text++ & 0x3F) << 6;
value |= (unsigned char)*text++ & 0x3F;
return value;
}
if ((first & 0xF8) == 0xF0) {
uint32_t value = (uint32_t)(first & 0x07) << 18;
value |= ((unsigned char)*text++ & 0x3F) << 12;
value |= ((unsigned char)*text++ & 0x3F) << 6;
value |= (unsigned char)*text++ & 0x3F;
return value;
}
return first;
}

uint32_t lowercaseSortCodepoint(uint32_t codepoint) {
if (codepoint >= 'A' && codepoint <= 'Z') return codepoint + ('a' - 'A');
if (codepoint >= 0x0410 && codepoint <= 0x042F) return codepoint + 0x20;
return codepoint;
}

int compareBulgarianNames(const char* first, const char* second) {
while (*first && *second) {
uint32_t a = lowercaseSortCodepoint(nextUtf8Codepoint(first));
uint32_t b = lowercaseSortCodepoint(nextUtf8Codepoint(second));
if (a < b) return -1;
if (a > b) return 1;
}
if (*first) return 1;
if (*second) return -1;
return 0;
}

