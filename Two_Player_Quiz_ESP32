if (oldIndex >= 0) studentStats[i] = oldStats[oldIndex];
strlcpy(studentStats[i].name, studentNames[i], sizeof(studentStats[i].name));
}
preferences.putString("students", studentsCsv);
preferences.putString("absent", absentCsv);
if (preferences.getString("students", "") != studentsCsv ||
preferences.getString("absent", "") != absentCsv) {
