}
return count;
}

int32_t periodWindowKey(uint8_t scope) {
if (scope == STATS_SCOPE_GAME) return -2;
struct tm now;
if (!getLocalDateTime(now)) return -1;
int32_t todayKey = (int32_t)(now.tm_year + 1900) * 400 + now.tm_yday;
if (scope == STATS_SCOPE_HOUR) return todayKey * 24 + now.tm_hour;
if (scope == STATS_SCOPE_DAY) return todayKey;
if (scope == STATS_SCOPE_WEEK) {
struct tm monday = now;
monday.tm_mday -= (monday.tm_wday + 6) % 7;
monday.tm_hour = 0;
monday.tm_min = 0;
monday.tm_sec = 0;
time_t mondayTime = mktime(&monday);
struct tm mondayLocal;
if (mondayTime != (time_t)-1 && localtime_r(&mondayTime, &mondayLocal)) {
return (int32_t)(mondayLocal.tm_year + 1900) * 400 + mondayLocal.tm_yday;
}
return todayKey;
}
return -3;
}

bool ensurePeriodWindow(PeriodStats& period, uint8_t scope) {
int32_t key = periodWindowKey(scope);
if (period.windowKey == key) return false;
period = PeriodStats();
period.windowKey = key;
return true;
}

void clearPeriodWindow(PeriodStats& period, uint8_t scope) {
period = PeriodStats();
period.windowKey = periodWindowKey(scope);
}

PeriodStats* getStudentPeriod(StudentStats& student, uint8_t scope) {
if (scope == STATS_SCOPE_GAME) return &student.game;
if (scope == STATS_SCOPE_HOUR) return &student.hour;
if (scope == STATS_SCOPE_DAY) return &student.day;
if (scope == STATS_SCOPE_WEEK) return &student.week;
return nullptr;
}

void addPeriodMatchPlayed(PeriodStats& period, uint8_t scope) {
ensurePeriodWindow(period, scope);
period.matchesPlayed++;
}

void addPeriodMatchWon(PeriodStats& period, uint8_t scope) {
ensurePeriodWindow(period, scope);
period.matchesWon++;
}

void addPeriodAnswer(PeriodStats& period, uint8_t scope, bool correct, uint32_t responseMs) {
ensurePeriodWindow(period, scope);
if (!correct) {
period.wrongAnswers++;
return;
}
period.correctAnswers++;
period.totalCorrectMs += responseMs;
if (!period.fastestCorrectMs || responseMs < period.fastestCorrectMs) {
period.fastestCorrectMs = responseMs ? responseMs : 1;
}
}

void recordStudentMatchPlayed(uint8_t index) {
if (index >= studentCount) return;
StudentStats& stats = studentStats[index];
stats.matchesPlayed++;
addPeriodMatchPlayed(stats.game, STATS_SCOPE_GAME);
addPeriodMatchPlayed(stats.hour, STATS_SCOPE_HOUR);
addPeriodMatchPlayed(stats.day, STATS_SCOPE_DAY);
addPeriodMatchPlayed(stats.week, STATS_SCOPE_WEEK);
studentStatsDirty[index] = true;
}

void recordStudentMatchWon(uint8_t index) {
if (index >= studentCount) return;
StudentStats& stats = studentStats[index];
stats.matchesWon++;
addPeriodMatchWon(stats.game, STATS_SCOPE_GAME);
addPeriodMatchWon(stats.hour, STATS_SCOPE_HOUR);
addPeriodMatchWon(stats.day, STATS_SCOPE_DAY);
addPeriodMatchWon(stats.week, STATS_SCOPE_WEEK);
studentStatsDirty[index] = true;
}

void recordStudentAnswer(uint8_t index, bool correct, uint32_t responseMs) {
if (index >= studentCount) return;
StudentStats& stats = studentStats[index];
if (correct) {
stats.correctAnswers++;
stats.totalCorrectMs += responseMs;
if (!stats.fastestCorrectMs || responseMs < stats.fastestCorrectMs) {
stats.fastestCorrectMs = responseMs ? responseMs : 1;
}
} else {
stats.wrongAnswers++;
}
addPeriodAnswer(stats.game, STATS_SCOPE_GAME, correct, responseMs);
addPeriodAnswer(stats.hour, STATS_SCOPE_HOUR, correct, responseMs);
addPeriodAnswer(stats.day, STATS_SCOPE_DAY, correct, responseMs);
addPeriodAnswer(stats.week, STATS_SCOPE_WEEK, correct, responseMs);
studentStatsDirty[index] = true;
}

PeriodStats statsForScope(const StudentStats& student, uint8_t scope) {
if (scope == STATS_SCOPE_GAME) return student.game;
if (scope == STATS_SCOPE_HOUR) return student.hour;
if (scope == STATS_SCOPE_DAY) return student.day;
if (scope == STATS_SCOPE_WEEK) return student.week;
PeriodStats all = {};
all.matchesPlayed = student.matchesPlayed;
all.matchesWon = student.matchesWon;
all.correctAnswers = student.correctAnswers;
all.wrongAnswers = student.wrongAnswers;
all.totalCorrectMs = student.totalCorrectMs;
all.fastestCorrectMs = student.fastestCorrectMs;
return all;
}

