// overflowing the ESP32 loop task stack while handling the web request.
static char newStudents[MAX_STUDENTS][32];
static char newAbsents[MAX_STUDENTS][32];
static StudentStats oldStats[MAX_STUDENTS];
memset(newStudents, 0, sizeof(newStudents));
memset(newAbsents, 0, sizeof(newAbsents));
memset(oldStats, 0, sizeof(oldStats));
uint8_t newStudentCount = 0, newAbsentCount = 0;
String incomingStudents = webServer.arg("students");
String incomingAbsent = webServer.arg("absent");
uint8_t newPointsToWin = tournamentPointsToWin;
String pointsInput = webServer.arg("pointsToWin");
if (pointsInput.length() > 0) {
long parsedPoints = pointsInput.toInt();
if (parsedPoints < MIN_TOURNAMENT_POINTS_TO_WIN || parsedPoints > MAX_TOURNAMENT_POINTS_TO_WIN) {
webServer.send(400, "text/plain; charset=utf-8", "Точките за победа трябва да са между 1 и 20.");
return;
}
newPointsToWin = (uint8_t)parsedPoints;
