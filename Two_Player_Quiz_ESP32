void handleWifiScan() {
static bool scanInProgress = false;
if (!scanInProgress) {
int16_t started = WiFi.scanNetworks(true, true);
if (started < 0 && started != WIFI_SCAN_RUNNING) {
WiFi.scanDelete();
webServer.send(500, "application/json; charset=utf-8", R"json({"scanning":false,"error":"ESP32 не успя да започне сканирането. Опитай отново."})json");
return;
}
scanInProgress = true;
}

int16_t networkCount = WiFi.scanComplete();
if (networkCount == WIFI_SCAN_RUNNING) {
webServer.send(200, "application/json; charset=utf-8", R"json({"scanning":true})json");
return;
}
if (networkCount == WIFI_SCAN_FAILED) {
scanInProgress = false;
WiFi.scanDelete();
webServer.send(500, "application/json; charset=utf-8", R"json({"scanning":false,"error":"Сканирането не завърши. Опитай отново."})json");
return;
}

String json = "{";
json += (char)34; json += "scanning"; json += (char)34; json += ":false,";
json += (char)34; json += "networks"; json += (char)34; json += ":[";
bool firstNetwork = true;
for (int16_t i = 0; i < networkCount; i++) {
String ssid = WiFi.SSID(i);
if (!ssid.length()) continue;
if (!firstNetwork) json += ',';
firstNetwork = false;
json += '{';
json += (char)34; json += "ssid"; json += (char)34; json += ':';
json += jsonEscape(ssid);
json += ',';
json += (char)34; json += "rssi"; json += (char)34; json += ':';
json += String(WiFi.RSSI(i));
json += ',';
json += (char)34; json += "channel"; json += (char)34; json += ':';
json += String(WiFi.channel(i));
json += ',';
json += (char)34; json += "secure"; json += (char)34; json += ':';
json += WiFi.encryptionType(i) == WIFI_AUTH_OPEN ? "false" : "true";
json += '}';
}
json += "]}";
scanInProgress = false;
WiFi.scanDelete();
webServer.send(200, "application/json; charset=utf-8", json);
}

