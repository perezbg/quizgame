void writeLittleEndian16(uint8_t* buffer, uint16_t offset, uint16_t value) {
buffer[offset] = value & 0xff;
buffer[offset + 1] = (value >> 8) & 0xff;
}

void writeLittleEndian32(uint8_t* buffer, uint16_t offset, uint32_t value) {
buffer[offset] = value & 0xff;
buffer[offset + 1] = (value >> 8) & 0xff;
buffer[offset + 2] = (value >> 16) & 0xff;
buffer[offset + 3] = (value >> 24) & 0xff;
}

void sendPreviewBmp() {
String l1 = expandTemplate(webServer.arg("line1"));
String l2 = expandTemplate(webServer.arg("line2"));
String a = expandTemplate(webServer.arg("answerA"));
String b = expandTemplate(webServer.arg("answerB"));
// Use exactly the same drawing code, fonts, separator and OLED 1 offset as the game.
drawQuestionCore(previewCanvas, previewFont, l1.c_str(), l2.c_str(), a.c_str(), b.c_str(), DISPLAY1_VERTICAL_OFFSET_Y);
static uint8_t bmp[62 + 128 * 64 / 8];
memset(bmp, 0, sizeof(bmp));
bmp[0] = 'B'; bmp[1] = 'M';
writeLittleEndian32(bmp, 2, sizeof(bmp));
writeLittleEndian32(bmp, 10, 62);
writeLittleEndian32(bmp, 14, 40);
writeLittleEndian32(bmp, 18, 128);
writeLittleEndian32(bmp, 22, 64);
writeLittleEndian16(bmp, 26, 1);
writeLittleEndian16(bmp, 28, 1);
writeLittleEndian32(bmp, 34, 1024);
writeLittleEndian32(bmp, 46, 2);
// 1-bit BMP palette: black then white, BGRA entries.
bmp[58] = bmp[59] = bmp[60] = 255;
for (uint8_t row = 0; row < 64; row++) {
int16_t y = 63 - row;
for (uint8_t x = 0; x < 128; x++) {
if (previewCanvas.getPixel(x, y)) bmp[62 + row * 16 + x / 8] |= (0x80 >> (x & 7));
}
}
webServer.setContentLength(sizeof(bmp));
webServer.send(200, "image/bmp", "");
webServer.sendContent((const char*)bmp, sizeof(bmp));
}

